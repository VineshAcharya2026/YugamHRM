rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPasswordSignIn() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaffRole(role) {
      return isPasswordSignIn() && hasProfile() && userRole() == role;
    }

    // Legacy seeded docs used role "admin". Google sign-in is never staff.
    function isMaster() {
      return isStaffRole('master') || (isPasswordSignIn() && hasProfile() && userRole() == 'admin');
    }

    function canWriteCandidates() {
      return isMaster() || isStaffRole('hr') || isStaffRole('placements');
    }

    function canReadCandidates() {
      return canWriteCandidates() || isStaffRole('operations') || isStaffRole('accounts') || isStaffRole('support');
    }

    function canPayments() {
      return isMaster() || isStaffRole('accounts');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isMaster();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'candidate';
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    match /resumes/{resumeId} {
      allow read: if isOwner(resource.data.userId) || canReadCandidates();
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid)
        || canWriteCandidates();
      allow update: if isOwner(resource.data.userId) || canWriteCandidates();
      allow delete: if isOwner(resource.data.userId) || canWriteCandidates();
    }

    match /documents/{docId} {
      allow read: if isOwner(resource.data.userId) || canReadCandidates();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isOwner(resource.data.userId) || canWriteCandidates())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId) || canWriteCandidates();
    }

    match /candidates/{candidateId} {
      allow read: if canReadCandidates() || isOwner(candidateId);
      allow create: if canWriteCandidates() || (
        isOwner(candidateId) &&
        request.resource.data.userId == request.auth.uid
      );
      allow update: if canWriteCandidates() || (
        isOwner(candidateId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if canWriteCandidates();
    }

    match /payments/{paymentId} {
      allow read, create, update, delete: if canPayments();
    }

    match /system/health {
      allow get: if true;
    }
  }
}
