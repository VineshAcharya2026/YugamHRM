rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Master admins: full read/write; keep emails in sync with src/lib/masterAdmin.ts
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'vineshjm@gmail.com' ||
        request.auth.token.email == 'sindhu@yugamcloud.online'
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()
      );
    }

    match /resumes/{resumeId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /documents/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if isAdmin() || isOwner(candidateId);
      allow create: if isAdmin() || (
        isOwner(candidateId) &&
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isOwner(candidateId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /system/health {
      allow get: if true;
    }
  }
}
