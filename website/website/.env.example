# HRM API base (no trailing slash).
# Dev: leave empty — Next.js rewrites `/hrm-api` → http://127.0.0.1:8787 (see next.config.mjs).
# Production: https://your-worker.workers.dev
NEXT_PUBLIC_HRM_API_BASE_URL=

# Set to `true` only for local UI testing without the Worker (placeholder session, no live API).
# Production: omit or `false` — users must sign in against the real API.
# NEXT_PUBLIC_HRM_OFFLINE_DEMO=false

# Optional — marketing AI chat (Gemini).
# Prefer NEXT_PUBLIC_GEMINI_API_KEY here, or GEMINI_API_KEY / VITE_GEMINI_API_KEY (next.config maps them for the client bundle).
# Keys in the repo root `.env.local` also work — see next.config.mjs load order.
# NEXT_PUBLIC_GEMINI_API_KEY=
