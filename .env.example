# --- Gemini (Vite HRM + merge-hosting Next build) ---
# HRM (Vite): set VITE_GEMINI_API_KEY and/or GEMINI_API_KEY in .env (see vite.config).
# Marketing AI chat (Next): expects NEXT_PUBLIC_GEMINI_API_KEY in website/website/.env.local
# OR the same key here — npm run build:hosting loads .env / .env.production / .env.local and copies
# GEMINI_API_KEY / VITE_GEMINI_API_KEY into the Next build as NEXT_PUBLIC_GEMINI_API_KEY.
# VITE_GEMINI_API_KEY=
# GEMINI_API_KEY=

# --- Public app URL (optional; defaults to window.location.origin) ---
# When HRM is hosted at /hrm/, set to that full URL, e.g. https://yugamcloud.online/hrm
# Production: see .env.production or override here.
VITE_APP_URL=

# Marketing site (optional). Use when HRM dev runs on a different port than Next (e.g. http://localhost:3000).
# VITE_MARKETING_URL=http://localhost:3000

# --- Firebase web app (optional; overrides firebase-applet-config.json per field) ---
# Set these in AI Studio / hosting env when you associate a different web app.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# --- One-off: seed Sindhu master (npm run seed:sindhu) — not used by Vite ---
# Option A: copy .env.seed.example → .env.seed and set FIREBASE_SERVICE_ACCOUNT_KEY + SINDHU_MASTER_PASSWORD
# Option B: set the same vars in your shell before npm run seed:sindhu
