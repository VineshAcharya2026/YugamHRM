rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Master email: keep in sync with `src/lib/masterAdmin.ts`
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'vineshjm@gmail.com' ||
        request.auth.token.email == 'sindhu@yugamcloud.online' ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSmallUserDoc() {
      return request.resource != null
        && request.resource.size < 16 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
        ];
    }

    function isAdminPdf() {
      return request.resource != null
        && request.resource.size < 16 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // User files: `documents/{uid}/...` from DocumentManager
    match /documents/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isSmallUserDoc();
    }

    // HR resume vault: `resumes/{uploaderAdminUid}/...` from CandidateTracker
    match /resumes/{uploaderId}/{allPaths=**} {
      allow read, delete: if isAdmin() && request.auth != null && request.auth.uid == uploaderId;
      allow create, update: if isAdmin()
        && request.auth != null
        && request.auth.uid == uploaderId
        && isAdminPdf();
    }
  }
}
