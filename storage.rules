rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPasswordSignIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function hasProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaffRole(role) {
      return isPasswordSignIn() && hasProfile() && userRole() == role;
    }

    function isMaster() {
      return isStaffRole('master') || (isPasswordSignIn() && hasProfile() && userRole() == 'admin');
    }

    function canWriteCandidates() {
      return isMaster() || isStaffRole('hr') || isStaffRole('placements');
    }

    function canReadCandidates() {
      return canWriteCandidates() || isStaffRole('operations') || isStaffRole('accounts') || isStaffRole('support');
    }

    function isSmallUserDoc() {
      return request.resource != null
        && request.resource.size < 16 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
        ];
    }

    function isAdminPdf() {
      return request.resource != null
        && request.resource.size < 16 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /documents/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isSmallUserDoc();
    }

    match /resumes/{uploaderId}/{allPaths=**} {
      allow read: if canReadCandidates();
      allow delete: if canWriteCandidates() && request.auth.uid == uploaderId;
      allow create, update: if canWriteCandidates()
        && request.auth.uid == uploaderId
        && isAdminPdf();
    }
  }
}
