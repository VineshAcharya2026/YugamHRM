{
  "hosting": {
    "public": "website/website/out",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/hrm", "destination": "/hrm/index.html" },
      { "source": "/hrm/**", "destination": "/hrm/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
